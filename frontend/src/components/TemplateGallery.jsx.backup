<head>
<style>
body { margin:0; font-family:${typography.fontFamily}; background:${colors.background}; color:#0ff; min-height:100vh; position:relative; font-size: ${typography.baseSize}; }
body::before { content:''; position:fixed; top:0; left:0; width:100%; height:100%; background-image:repeating-linear-gradient(0deg, rgba(97,218,251,0.03) 0px, transparent 1px, transparent 2px, rgba(97,218,251,0.03) 3px); background-size:100% 20px; z-index:-1; pointer-events:none; }
.nav { background:rgba(15,23,42,0.95); border-bottom:1px solid #1e293b; padding:${layout.padding}; display:flex; justify-content:space-between; align-items:center; }
.nav h2 { color:${colors.primary}; font-size:20px; font-weight:600; font-family:'Courier New', monospace; display:flex; align-items:center; gap:10px; }
.nav h2::before { content:'$'; color:#5c6370; }
.nav .btn { background:transparent; color:${colors.primary}; border:1px solid ${colors.primary}; padding:10px 20px; font-family:'Courier New', monospace; font-size:14px; cursor:pointer; transition:all 0.3s ease; position:relative; overflow:hidden; border-radius: ${components.buttonRadius}; }
.nav .btn::before { content:''; position:absolute; top:0; left:-100%; width:100%; height:100%; background:${colors.primary}; transition:left 0.3s ease; z-index:-1; }
.nav .btn:hover::before { left:0; }
.nav .btn:hover { color:#0f172a; box-shadow:0 0 10px ${colors.primary}; }
.hero { text-align:center; padding:80px 20px; position:relative; }
.hero h1 { font-size:48px; font-weight:300; margin-bottom:20px; color:#ffffff; font-family:'Courier New', monospace; }
.typing-text { color:${colors.primary}; border-right:2px solid ${colors.primary}; animation:blink 1s infinite; white-space:nowrap; overflow:hidden; width:0; animation:typing 3s steps(30) 1s forwards, blink 1s infinite; }
@keyframes typing { from { width:0; } to { width:100%; } }
@keyframes blink { 0%,50% { border-color:${colors.primary}; } 51%,100% { border-color:transparent; } }
.hero p { font-size:18px; line-height:1.6; margin-bottom:30px; color:#5c6370; max-width:600px; margin-left:auto; margin-right:auto; }
.hero .btn { background:linear-gradient(45deg, ${colors.accent}, #ff8787); color:white; border:none; padding:15px 30px; font-family:'Courier New', monospace; font-size:16px; font-weight:500; cursor:pointer; transition:all 0.3s ease; position:relative; overflow:hidden; border-radius: ${components.buttonRadius}; }
.hero .btn:hover { transform:translateY(-2px); box-shadow:0 5px 15px rgba(255,107,107,0.4); }
.projects { padding:60px 20px; max-width:${layout.containerWidth}; margin:0 auto; }
.projects h3 { color:#ffffff; font-size:24px; margin-bottom:30px; text-align:center; font-family:'Courier New', monospace; font-weight: ${typography.headingWeight}; }
.project-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:30px; }
.project-card { background:#1e293b; border:1px solid #334155; padding:30px; border-radius:${layout.radius}; transition:all 0.4s ease; position:relative; overflow:hidden; }
.project-card::before { content:''; position:absolute; top:0; left:0; width:100%; height:2px; background:linear-gradient(90deg, ${colors.primary}, ${colors.accent}); }
.project-card:hover { transform:translateY(-5px); border-color:${colors.primary}; box-shadow:0 10px 30px rgba(97,218,251,0.2); }
.project-card h4 { color:${colors.primary}; font-size:20px; margin-bottom:15px; font-family:'Courier New', monospace; }
.project-card p { color:#94a3b8; line-height:1.6; font-size:14px; margin-bottom:20px; }
.project-tags { display:flex; gap:10px; flex-wrap:wrap; }
.tag { background:rgba(97,218,251,0.1); color:${colors.primary}; padding:4px 8px; border-radius:4px; font-size:12px; font-family:'Courier New', monospace; }
.terminal-section { background:#0f172a; border:1px solid #1e293b; border-radius:${layout.radius}; padding:30px; margin:40px; font-family:'Courier New', monospace; position:relative; overflow:hidden; }
.terminal-header { color:${colors.primary}; margin-bottom:20px; }
.terminal-content { color:#10b981; font-size:14px; line-height:1.8; }
.comment { color:#5c6370; font-style:italic; }
.string { color:#10b981; }
.keyword { color:#f472b6; }
.function { color:${colors.primary}; }
footer { background:#0f172a; border-top:1px solid #1e293b; text-align:center; padding:30px 20px; color:#5c6370; font-family:'Courier New', monospace; font-size:14px; margin-top:60px; }
footer::before { content:'// '; color:${colors.primary}; }
</style>
</head>
